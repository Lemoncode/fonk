{
  "name": "fonk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playgrounds/**/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.2.0",
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "install:browsers": "playwright install",
    "scripts": "tsx ./run-scripts",
    "start": "npm run scripts -- start",
    "dev": "npm start",
    "test:watch": "npm run scripts -- test-watch",
    "pree2e:watch": "npm run install:browsers",
    "e2e:watch": "npm run scripts -- e2e-watch",
    "build": "turbo build",
    "test": "turbo test",
    "pree2e": "npm run install:browsers",
    "e2e": "cross-env CI=true npm run scripts -- e2e",
    "changeset": "changeset",
    "publish-packages": "changeset publish",
    "prelocal:publish": "npm run build && cd ./local-npm-registry && npm start",
    "local:publish": "changeset version && node local-npm-registry/publish.js changeset publish",
    "prepare": "husky || echo 'Husky is not installed'"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.17",
    "@types/prompts": "^2.4.9",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.1.1",
    "prompts": "^2.4.2",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vitest": "^3.1.1"
  }
}
