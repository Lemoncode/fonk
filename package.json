{
  "name": "fonk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playgrounds/*",
    "playgrounds/vanilla/01-validate-field"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.2.0",
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "scripts": "tsx ./run-scripts",
    "start": "npm run scripts -- start",
    "dev": "npm start",
    "test:watch": "npm run scripts -- test-watch",
    "build": "turbo build",
    "test": "turbo test",
    "changeset": "changeset",
    "publish-packages": "changeset publish",
    "prelocal:publish": "npm run build && cd ./local-npm-registry && npm start",
    "local:publish": "changeset version && node local-npm-registry/publish.js changeset publish",
    "prepare": "husky || echo 'Husky is not installed'"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@types/node": "^22.13.17",
    "@types/prompts": "^2.4.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.1.1",
    "prompts": "^2.4.2",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vitest": "^3.1.1"
  }
}
